rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /_connection_test/{testId} {
      allow read, write: if isValidId(testId);
    }

    match /settings/{settingId} {
      allow get, write: if isValidId(settingId);
      allow list: if true;
    }

    match /students/{studentId} {
      allow get, write: if isValidId(studentId);
      allow list: if true;
    }

    match /classes/{classId} {
      allow get, write: if isValidId(classId);
      allow list: if true;
    }

    match /subjects/{subjectId} {
      allow get, write: if isValidId(subjectId);
      allow list: if true;
    }

    match /rooms/{roomId} {
      allow get, write: if isValidId(roomId);
      allow list: if true;
    }

    match /supervisors/{supervisorId} {
      allow get, write: if isValidId(supervisorId);
      allow list: if true;
    }

    match /schedules/{scheduleId} {
      allow get, write: if isValidId(scheduleId);
      allow list: if true;
    }

    match /minutes/{minuteId} {
      allow get, write: if isValidId(minuteId);
      allow list: if true;
    }

    match /attendances/{attendanceId} {
      allow get, write: if isValidId(attendanceId);
      allow list: if true;
    }

    match /makeups/{makeupId} {
      allow get, write: if isValidId(makeupId);
      allow list: if true;
    }

    match /auditLogs/{logId} {
      allow get, write: if isValidId(logId);
      allow list: if true;
    }
  }
}
